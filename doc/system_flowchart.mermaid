flowchart TD
    subgraph Host["Host System"]
        A["RustBox parent process"]
        H["Manager process"]
    end

    subgraph Creation["Namespace Setup"]
        direction TB
        B["unshare(2)<br/>CLONE_NEWUTS<br/>CLONE_NEWPID<br/>CLONE_NEWNS"]
        B1["UTS<br/>hostname isolation"]
        B2["PID<br/>process isolation"]
        B3["MOUNT<br/>mount points"]
    end

    subgraph Isolation["Filesystem Isolation"]
        direction TB
        C["<b>CHROOT</b><br/>change root"]
        C1["./alpine becomes new /"]
        D["mount --make-rprivate /<br/>prevent propagation"]
        E["PID 1 child mounts proc<br/>inside its PID namespace"]
    end

    subgraph Runtime["Execution"]
        F["Configured command"]
        F1["Runs as PID 1"]
    end

    subgraph Resources["Cgroups v2"]
        R1["cpu.max<br/>2 cores"]
        R2["memory.max<br/>2 GiB"]
    end

    A -->|"spawn manager"| H
    H -->|"create per-container cgroup"| R1 & R2
    H --> B
    B --> B1 & B2 & B3
    B --> D
    D --> C
    C --> C1
    C1 -->|"spawn child into new PID namespace"| E
    E --> F
    F --> F1
    F1 --> G["Running with isolated PID, hostname, and rootfs"]
    R1 & R2 --> F1